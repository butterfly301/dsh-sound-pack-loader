{
  "name": "dsh-sound-pack-loader",
  "version": "0.1.0",
  "type": "module",
  "description": "Plays configured notification chimes for completed, failed, and waiting-for-confirmation agent events when the window is in the background.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butterfly301/dsh-sound-pack-loader.git"
  },
  "homepage": "https://github.com/butterfly301/dsh-sound-pack-loader#readme",
  "bugs": {
    "url": "https://github.com/butterfly301/dsh-sound-pack-loader/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notify",
    "sound"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "files": [
    "index.js",
    "client.js",
    "host",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
